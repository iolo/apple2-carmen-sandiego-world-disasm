  "policies": {
    "geography": "Preserve period borders, currencies and names, including the Soviet Union, Yugoslavia and Czechoslovakia. Do not add a destination name when the original gives only a geographic clue.",
    "voice": {
      "interface": "Polite, direct instructions and concise labels.",
      "city_descriptions": "Concise encyclopedic prose ending in -다.",
      "clue_fragments": "Reported past tense, without a final period when N adds it."
    },
    "input": "Detective names stay ASCII, at most 15 characters. Preserve Y/N, Return/Escape and Control-D. Keep the original 15-entry English name blacklist separately from translated display names. The original glyph-start byte-column limit of 16 also remains; wide names can stop before 15 characters.",
    "weekdays": "Clock uses one-syllable weekday stems. All weekday suffixes become empty; C UI 071 supplies 요일, in full deadline messages.",
    "promotion_counter": "One/Two/Three/Four use 한/두/세/네 before 건. Remove N inline plural s and its append cursor increment; do not emit a Korean plural suffix.",
    "embedded_pronouns": "Outer He/She prefixes retain 그는/그녀는. Embedded subject/object markers refer to the same suspect and use reflexive 자신; possessive uses 자신의. Keep #/@/^ markers and the game sex selection.",
    "female_object_branch": "English her is shared by possessive @ and object ^ at C UI 104. K4 must route female ^ to the distinct object text at UI 105; a possessive must not appear in an object context.",
    "real_creator_names": "Retain original Roman spelling in creator credits, including DANE BIGHAM, GENE PORTWOOD, LAUREN ELLIOTT and KEN BULL."
